# 生成目录
graphify-out/

# 视频下载产物（可用 scripts/download_video.py --output 改到别处）
# 只忽略仓库根目录下的 downloads/，前面必须带斜杠。
# 不带斜杠的 `downloads/` 会连 scripts/downloads/（管道源码）一起忽略，
# 实测 `git check-ignore scripts/downloads/common.py` 命中这条规则。
/downloads/

# 检索结果中间产物（SSOT 是 data/resources.json，这只是并发写入冲突时的恢复备份）
data/videos_bilibili.json

# 全局/工具记忆残留（记忆 SSOT 是根目录 PROJECT_MEMORY.md）
.claude-mem/
.project-memory-backups/

# 本地凭据（明文 Cookie / token，绝不入库）
.credentials/

# 本地工具二进制（贡献约定禁止提交可执行文件）
.tools/

# Windows 上 cmd 展开残留的目录名
/%SystemDrive%/
/%USERPROFILE%/

# CLI 把状态写进项目内时的残留（gh 等；HOME 未正确解析时出现）
/.local/
